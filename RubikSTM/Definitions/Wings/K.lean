def wordOf (w : List Token) : Word := (w.map tokenFree).prod
def finiteOf (w : List Token) : Equiv.Perm Label := (w.map tokenFinite).prod

def cycle4 (v : Fin 4 → Label) : Equiv.Perm Label :=
